# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root
RUN rm -rf /opt/paperclip-runner/provider-pack
ADD provider-pack.tar.gz /opt/paperclip-runner/provider-pack/
COPY --chmod=0755 paperclip-runnerd /usr/local/bin/paperclip-runnerd
